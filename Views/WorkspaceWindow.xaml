<Window x:Class="Nava.Views.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nava.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="نوا | یادداشت‌های صوتی" Style="{StaticResource {x:Type Window}}" Foreground="{StaticResource Paper}" Width="990" Height="760" MinWidth="780" MinHeight="620" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" WindowStyle="None" FlowDirection="RightToLeft" Background="{StaticResource Ink}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="6"/></shell:WindowChrome.WindowChrome>
 <Border Background="{StaticResource Ink}" BorderBrush="#3C4B53" BorderThickness="1" Padding="22,16">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Border Background="{StaticResource Mint}" CornerRadius="13" Width="41" Height="41"><TextBlock Text="ن" FontWeight="Bold" FontSize="25" Foreground="{StaticResource Ink}" TextAlignment="Center" Margin="0,-2,0,0"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="نوا" FontSize="21" FontWeight="Bold"/><TextBlock Text="تو بگو، من می‌نویسم." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3"><Button x:Name="HistoryNav" Content="یادداشت‌ها" Click="HistoryClick" Style="{StaticResource PrimaryButton}" Margin="3,0"/><Button x:Name="SettingsNav" Content="تنظیمات" Click="SettingsClick" Style="{StaticResource QuietButton}" Margin="3,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="LeftToRight"><Button Content="×" FontSize="20" Style="{StaticResource QuietButton}" Click="CloseClick" AutomationProperties.Name="بستن پنجره" ToolTip="بستن پنجره؛ نوا فعال می‌ماند"/><Button Content="−" FontSize="18" Style="{StaticResource QuietButton}" Click="MinimizeClick" AutomationProperties.Name="کوچک کردن پنجره"/></StackPanel>
   </Grid>
   <Grid x:Name="HistoryPanel" Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="14">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="صداهای تو" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Records.Count}" Foreground="{StaticResource Mint}" FontFamily="Consolas" VerticalAlignment="Center"/></Grid>
      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,12" TextChanged="SearchChanged" ToolTip="جست‌وجو در عنوان و متن" AutomationProperties.Name="جست‌وجوی یادداشت‌ها"/>
      <Grid Grid.Row="2"><ListBox x:Name="HistoryList" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Paper}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HistorySelectionChanged">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" CornerRadius="11" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="11"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#34453F"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6C9A80"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#303D42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5" MaxHeight="38"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateLabel}" FontSize="9.5" Foreground="#91A6AF" FlowDirection="LeftToRight" HorizontalAlignment="Right"/><TextBlock Grid.Column="1" Text="{Binding DurationLabel}" FontSize="9.5" Foreground="{StaticResource Mint}" FontFamily="Consolas" Margin="4,0"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox><TextBlock x:Name="EmptyHistory" Text="اولین یادداشتت از همین‌جا شروع می‌شود." Foreground="{StaticResource Muted}" Margin="8,24" TextAlignment="Center" Visibility="Collapsed"/></Grid>
      <StackPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="RecordButton" Content="نگه دار و صحبت کن" Style="{StaticResource PrimaryButton}"/><Button x:Name="ImportButton" Content="وارد کردن فایل صوتی / ویدیو" Click="ImportClick" Style="{StaticResource QuietButton}" Margin="0,5,0,0"/><Button x:Name="CancelButton" Content="لغو عملیات" Click="CancelClick" Style="{StaticResource QuietButton}" Foreground="{StaticResource Coral}" Visibility="Collapsed"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Column="2">
     <Grid x:Name="WelcomePanel" VerticalAlignment="Center" Margin="28">
      <StackPanel HorizontalAlignment="Center" MaxWidth="360"><Border Background="#2B3B34" CornerRadius="28" Width="92" Height="92" HorizontalAlignment="Center" Margin="0,0,0,23"><views:CharacterAvatar Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center" CharacterId="{Binding CharacterId}"/></Border><TextBlock Text="فکرهایت را بلند بگو." FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="فارسی، انگلیسی یا ترکیبی از هر دو. نوا حرف‌هایت را می‌نویسد و صدای گوینده‌ها را از هم جدا می‌کند." Foreground="{StaticResource Muted}" FontSize="13" LineHeight="25" TextAlignment="Center" Margin="0,15"/><Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14" Margin="0,10"><TextBlock Text="{Binding HotkeyLabel, StringFormat=برای صحبت، {0} را نگه دار}" TextAlignment="Center" Foreground="{StaticResource Mint}"/></Border><Button x:Name="WelcomeRecordButton" Content="نگه دار و صحبت کن" Style="{StaticResource PrimaryButton}" Margin="30,12"/><TextBlock Text="فقط هنگام ضبط به میکروفن گوش می‌دهم." Foreground="#8DA49C" FontSize="10" TextAlignment="Center"/></StackPanel>
     </Grid>
     <Grid x:Name="EditorPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBox Text="{Binding SelectedRecord.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="21" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0,4" LostFocus="SaveText" ToolTip="برای تغییر عنوان کلیک کنید"/><StackPanel Orientation="Horizontal" Margin="0,8,0,10"><TextBlock Text="{Binding SelectedRecord.DateLabel}" Foreground="{StaticResource Muted}" FontSize="10.5" FlowDirection="LeftToRight"/><TextBlock Text=" · " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedRecord.DurationLabel}" Foreground="{StaticResource Mint}" FontFamily="Consolas" FontSize="10.5"/><TextBlock Text=" · فارسی و انگلیسی" Foreground="{StaticResource Muted}" FontSize="10.5"/></StackPanel></StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="کپی متن" Style="{StaticResource PrimaryButton}" Click="CopyClick" Margin="0,0,5,5"/><Button x:Name="FormatButton" Content="مرتب‌سازی متن" Click="FormatClick" Margin="0,0,5,5"/><Button Content="خروجی ▾" Click="ExportClick" Margin="0,0,5,5"><Button.ContextMenu><ContextMenu><MenuItem Header="متن ساده (.txt)" Tag="txt" Click="ExportFormatClick"/><MenuItem Header="زیرنویس (.srt)" Tag="srt" Click="ExportFormatClick"/><MenuItem Header="دادهٔ کامل (.json)" Tag="json" Click="ExportFormatClick"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="SpeakersButton" Content="نام گوینده‌ها" Click="SpeakersClick" Margin="0,0,5,5"/><Button x:Name="RetryButton" Content="تلاش دوباره" Click="RetryClick" Margin="0,0,5,5" Visibility="Collapsed"/><Button x:Name="AudioButton" Content="پخش صدا" Click="AudioClick" Margin="0,0,5,5" Visibility="Collapsed"/><Button x:Name="DeleteButton" Content="حذف" Click="DeleteClick" Foreground="{StaticResource Coral}" Style="{StaticResource QuietButton}" Margin="0,0,0,5"/></WrapPanel>
      <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="TextNav" Content="خواندن" Style="{StaticResource PrimaryButton}" Click="TextTabClick" Margin="0,0,6,0"/><Button x:Name="EditNav" Content="ویرایش" Style="{StaticResource QuietButton}" Click="EditTabClick" Margin="0,0,6,0"/><Button x:Name="SegmentsNav" Content="گوینده‌ها و زمان" Style="{StaticResource QuietButton}" Click="SegmentsTabClick" Margin="0,0,6,0"/><Button x:Name="AnalysisNav" Content="خلاصه و کارها" Style="{StaticResource QuietButton}" Click="AnalysisTabClick"/><Button x:Name="DirectionButton" Content="RTL ⇄ LTR" Style="{StaticResource QuietButton}" Click="DirectionClick" FlowDirection="LeftToRight" ToolTip="جهت نمایش متن در ویرایشگر" Visibility="Collapsed" FontSize="10"/></StackPanel>
       <FlowDocumentScrollViewer x:Name="TranscriptReader" Grid.Row="1" FlowDirection="LeftToRight" Background="{StaticResource Surface}" Foreground="{StaticResource Paper}" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="متن ترنسکرایپت با جهت خودکار فارسی و انگلیسی"/>
       <TextBox x:Name="TranscriptEditor" Grid.Row="1" Visibility="Collapsed" Text="{Binding SelectedRecord.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="16" Background="{StaticResource Surface}" BorderThickness="0" LostFocus="SaveText" SpellCheck.IsEnabled="False" AutomationProperties.Name="متن ترنسکرایپت قابل ویرایش"/>
       <Border x:Name="WorkspaceLivePanel" Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource Mint}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,12"/><ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource Mint}" Background="#40524B" BorderThickness="0" Margin="0,0,0,14" Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}"/></StackPanel><ScrollViewer x:Name="WorkspaceLiveScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="WorkspaceLivePlaceholder" Text="گوش می‌کنم… صحبت کن تا همین‌جا بنویسم." Foreground="{StaticResource Muted}" FontSize="17" LineHeight="31"/><TextBlock Foreground="{StaticResource Paper}" FontSize="18" LineHeight="33" TextWrapping="Wrap"><Run Text="{Binding FinalText, Mode=OneWay}"/><Run Text="{Binding PartialText, Mode=OneWay}" Foreground="{StaticResource Mint}" FontStyle="Italic"/></TextBlock></StackPanel></ScrollViewer><TextBlock Grid.Row="2" Text="برای پایان رها کن. متن سبز هنوز در حال کامل شدن است." FontSize="11" Foreground="#A7C7B4" Margin="0,14,0,0"/></Grid></Border>
       <Grid x:Name="SegmentsPane" Grid.Row="1" Visibility="Collapsed"><ListBox x:Name="SegmentsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Paper}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface}" CornerRadius="12" Padding="14" Margin="0,0,0,10"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Speaker}" Foreground="{StaticResource Mint}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,0" FlowDirection="LeftToRight" FontFamily="Consolas"/><TextBlock Text="{Binding Language}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><TextBlock Text="{Binding Text}" FlowDirection="{Binding Direction}" TextAlignment="{Binding Alignment}" FontSize="14" LineHeight="25" Margin="0,9,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
       <Grid x:Name="AnalysisPane" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="از حرف‌ها، به نکته‌ها برس." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><Border x:Name="CapabilityNotice" Background="#3E352B" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock Text="{Binding ServerFeatureNotice}" Foreground="#F2D2AA" FontSize="12" LineHeight="22"/></Border></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AnalysisAction" SelectedIndex="0" SelectionChanged="AnalysisActionChanged"><ComboBoxItem Content="خلاصهٔ متن" Tag="summarize"/><ComboBoxItem Content="نکته‌های کلیدی" Tag="extract_key_points"/><ComboBoxItem Content="فهرست کارها" Tag="to_do_list"/><ComboBoxItem Content="نام‌ها و موجودیت‌ها" Tag="named_entities"/><ComboBoxItem Content="خلاصه به تفکیک گوینده" Tag="summary_per_speaker"/><ComboBoxItem Content="نقل‌قول گوینده‌ها" Tag="speaker_quotation"/><ComboBoxItem Content="درخواست دلخواه" Tag="custom"/></ComboBox><Button x:Name="AnalyzeButton" Grid.Column="1" Content="انجام بده" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AnalyzeClick"/></Grid><TextBox x:Name="CustomPrompt" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0" AcceptsReturn="True" Height="70" TextWrapping="Wrap" ToolTip="بگو چه چیزی از این متن لازم داری" AutomationProperties.Name="درخواست دلخواه برای تحلیل"/><TextBox Grid.Row="3" Text="{Binding AnalysisText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" Background="{StaticResource Surface}" BorderThickness="0" Padding="14" FontSize="14" AutomationProperties.Name="نتیجه تحلیل"/></Grid>
      </Grid>
      <TextBlock Grid.Row="3" Text="در حالت ویرایش، تغییرها خودکار ذخیره می‌شوند. جهت هر پاراگراف در حالت خواندن خودکار است." Foreground="#91A59D" FontSize="10" Margin="0,12,0,0"/>
     </Grid>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="690" HorizontalAlignment="Center" Margin="5,8,5,16">
     <TextBlock Text="همان‌طور که راحت‌تری." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="میانبر، میکروفن و رفتار نوا را برای خودت تنظیم کن." Foreground="{StaticResource Muted}" Margin="0,8,0,23"/>
     <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="همراهت را انتخاب کن" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="همان صدا، یک چهرهٔ تازه. با یک کلیک عوض می‌شود." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,14"/>
      <ListBox x:Name="CharacterPicker" Width="590" Padding="0" HorizontalAlignment="Center" ItemsSource="{Binding Characters}" SelectedValuePath="Id" SelectedValue="{Binding CharacterId, Mode=OneWay}" SelectionChanged="CharacterSelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="انتخاب همراه نوا">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="110"/><Setter Property="Height" Value="103"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Description}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CharacterCard" CornerRadius="13" BorderThickness="1" BorderBrush="#40514F" Background="#28343B" Padding="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CharacterCard" Property="BorderBrush" Value="{StaticResource Mint}"/><Setter TargetName="CharacterCard" Property="BorderThickness" Value="2"/><Setter TargetName="CharacterCard" Property="Background" Value="#34473E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CharacterCard" Property="Background" Value="#354740"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CharacterCard" Property="BorderBrush" Value="{StaticResource Paper}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><views:CharacterAvatar CharacterId="{Binding Id}" Width="40" Height="40" HorizontalAlignment="Center"/><TextBlock Text="{Binding Name}" Foreground="{StaticResource Paper}" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="94" FontSize="11" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel></Border>
     <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="ضبط و میانبر" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="میانبر سراسری" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyKeyDown" GotKeyboardFocus="HotkeyFocus" LostKeyboardFocus="HotkeyBlur" FlowDirection="LeftToRight" ToolTip="کلیک کنید و کلید یا ترکیب دلخواه را بزنید"/><TextBlock x:Name="HotkeyHelp" Text="کلیک کن و کلید دلخواهت را بزن." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="میکروفن" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel></Grid><CheckBox x:Name="LiveCheck" Content="نمایش متن زنده هنگام صحبت، همیشه فعال است" IsEnabled="False" IsChecked="True" Margin="0,18,0,8"/><CheckBox x:Name="DiarizationCheck" Content="تشخیص و جدا کردن گوینده‌ها"/><CheckBox x:Name="SoundsCheck" Content="صدای کوتاه برای شروع و پایان ضبط"/></StackPanel></Border>
     <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="بعد از نوشتن" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/><CheckBox x:Name="AutoCopyCheck" Content="متن نهایی خودکار در کلیپ‌بورد کپی شود"/><CheckBox x:Name="AutoPasteCheck" Content="متن در برنامه‌ای که از آن ضبط را شروع کردم چسبانده شود"/><TextBlock Text="چسباندن خودکار با Ctrl+V انجام می‌شود؛ برای پیام‌ها قبل از ارسال، متن را مرور کن." FontSize="10.5" Foreground="{StaticResource Muted}" Margin="19,0,0,8"/><CheckBox x:Name="KeepAudioCheck" Content="فایل صوتی ضبط‌شده پس از تبدیل هم نگه داشته شود"/><CheckBox x:Name="StartupCheck" Content="نوا با ورود به ویندوز اجرا شود"/></StackPanel></Border>
     <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="اتصال به سرویس تو" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="آدرس سرویس" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="EndpointBox" FlowDirection="LeftToRight"/><TextBlock Text="کلید دسترسی" Foreground="{StaticResource Muted}" Margin="0,14,0,7"/><PasswordBox x:Name="ApiKeyBox" FlowDirection="LeftToRight"/><TextBlock Text="پروکسی پشتیبان (اختیاری)" Foreground="{StaticResource Muted}" Margin="0,14,0,7"/><PasswordBox x:Name="ProxyBox" FlowDirection="LeftToRight"/><TextBlock Text="اول اتصال مستقیم امتحان می‌شود. این پروکسی فقط برای درخواست ناموفق همین سرویس استفاده می‌شود." FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/><TextBlock Text="کلید و پروکسی با حساب ویندوزت رمز می‌شوند. صدا فقط برای تبدیل به سرویس تعیین‌شده فرستاده می‌شود." FontSize="10.5" Foreground="#ABC9B5" Margin="0,11,0,0"/></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="SaveSettingsButton" Content="ذخیرهٔ تنظیمات" Click="SaveSettingsClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="TestButton" Content="آزمایش اتصال ذخیره‌شده" Click="TestConnectionClick" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="SettingsFeedback" Grid.Column="1" Foreground="{StaticResource Mint}" VerticalAlignment="Center" Margin="10,0"/></Grid>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#33434B" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,7,0"/><TextBlock Text="{Binding Status}" FontSize="11"/><TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource Muted}" FontSize="10" Margin="13,0"/></StackPanel><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Coral}" FontSize="11" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"/></StackPanel><Button Grid.Column="1" Content="نمایش نوا ↗" Style="{StaticResource QuietButton}" Click="ShowOverlayClick" MinHeight="25"/></Grid></Border>
  </Grid>
 </Border>
</Window>
