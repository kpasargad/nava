<Window x:Class="Nava.Views.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nava.Views" Title="نوا • دستیار صوتی" Style="{StaticResource {x:Type Window}}" Foreground="{StaticResource Paper}" Width="40" Height="44" SizeToContent="Manual" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" FlowDirection="LeftToRight">
 <Window.Resources><Style x:Key="Tiny" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="MinHeight" Value="27"/><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="11"/></Style></Window.Resources>
 <Canvas x:Name="PresentationRoot" FlowDirection="LeftToRight" Width="40" Height="44" Background="Transparent"><Border x:Name="ExpandedCard" FlowDirection="RightToLeft" Width="328" CornerRadius="23" Background="#F51B242B" BorderBrush="#4B62705E" BorderThickness="1" Padding="16,13" Visibility="Collapsed">
  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28"/></Border.Effect>
  <StackPanel>
   <Grid MouseLeftButtonDown="DragHeader" Cursor="SizeAll" ToolTip="برای جابه‌جایی بکشید">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="نوا" FontSize="17" FontWeight="Bold"/><Border Background="#2B383C" CornerRadius="6" Padding="7,2" Margin="9,0,0,0"><TextBlock Text="{Binding HotkeyLabel}" FontSize="10" Foreground="{StaticResource Mint}" FlowDirection="LeftToRight"/></Border></StackPanel>
    <Button Grid.Column="1" Content="×" Style="{StaticResource Tiny}" FontSize="19" Click="HideClick" AutomationProperties.Name="جمع کردن نوا" ToolTip="جمع کردن پنجره؛ همراه کوچک می‌ماند"/>
   </Grid>
   <Grid Margin="0,10,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="49"/></Grid.ColumnDefinitions>
    <Grid x:Name="Face" Width="48" Height="48" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><ScaleTransform x:Name="FaceScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform><views:CharacterAvatar x:Name="LargeAvatar" Width="48" Height="48" CharacterId="{Binding CharacterId}" IsRecording="{Binding IsRecording}"/></Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,7,0"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0" MaxHeight="34"/></StackPanel>
    <Button x:Name="RecordButton" Grid.Column="2" Width="45" Height="45" Style="{StaticResource PrimaryButton}" Padding="0" ToolTip="نگه دار و صحبت کن؛ برای پایان رها کن" AutomationProperties.Name="نگه دار و صحبت کن"><Grid><Ellipse x:Name="MicDot" Fill="#233D30" Width="12" Height="18"/><Rectangle x:Name="StopSquare" Fill="#233D30" Width="15" Height="15" RadiusX="3" RadiusY="3" Visibility="Collapsed"/></Grid></Button>
   </Grid>
   <Grid x:Name="WavePanel" Height="24" Visibility="Collapsed" Margin="4,0,4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="{StaticResource Mint}" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/></Grid>
   <Border x:Name="TranscriptPanel" Background="#263139" CornerRadius="14" Padding="13" Margin="0,4,0,12" Visibility="Collapsed">
    <StackPanel>
     <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveIndicator" Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,7,0"/><TextBlock x:Name="LiveCaption" Text="متن زنده" Foreground="{StaticResource Mint}" FontSize="10.5"/></StackPanel><TextBlock Grid.Column="1" x:Name="LiveConnection" Foreground="{StaticResource Muted}" FontSize="10"/></Grid>
     <ProgressBar x:Name="ConnectingProgress" Height="2" IsIndeterminate="True" Foreground="{StaticResource Mint}" Background="#3B4B50" BorderThickness="0" Margin="0,0,0,10" Visibility="Collapsed"/>
     <ScrollViewer x:Name="LiveScroller" MaxHeight="180" MinHeight="54" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="LivePlaceholder" Foreground="{StaticResource Muted}" FontSize="14" LineHeight="27"/><TextBlock x:Name="LiveTextBlock" Foreground="{StaticResource Paper}" FontSize="15" LineHeight="28" TextWrapping="Wrap"><Run x:Name="FinalLiveRun"/><Run x:Name="PartialLiveRun" Foreground="{StaticResource Mint}" FontStyle="Italic"/></TextBlock></StackPanel></ScrollViewer>
     <TextBlock x:Name="ReleaseHint" Text="برای پایان، دکمه یا میانبر را رها کن." Foreground="#98B3A4" FontSize="10" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
   <Border Background="#3C2828" CornerRadius="9" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#F3BDB1" FontSize="10.5" MaxHeight="90"/></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="یادداشت‌ها" Style="{StaticResource Tiny}" Click="HistoryClick"/><Button x:Name="ImportButton" Content="＋ فایل" Style="{StaticResource Tiny}" Click="ImportClick" ToolTip="تبدیل فایل صوتی یا ویدیویی"/><Button Content="⚙" Style="{StaticResource Tiny}" Click="SettingsClick" AutomationProperties.Name="تنظیمات" ToolTip="تنظیمات"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="لغو" Style="{StaticResource Tiny}" Foreground="{StaticResource Coral}" Click="CancelClick" Visibility="Collapsed"/></Grid>
  </StackPanel>
 </Border>
 <Button x:Name="MiniDock" Width="40" Height="44" Padding="0" Background="#01000000" BorderThickness="0" Opacity="0.65" Cursor="Hand" Click="MiniClick" PreviewMouseLeftButtonDown="MiniMouseDown" PreviewMouseLeftButtonUp="MiniMouseUp" PreviewMouseMove="MiniMouseMove" LostMouseCapture="MiniLostCapture" MouseEnter="MiniMouseEnter" MouseLeave="MiniMouseLeave" AutomationProperties.Name="نوا؛ باز کردن دستیار صوتی" ToolTip="نوا؛ برای باز کردن کلیک کن، برای جابه‌جایی بکش">
  <!-- Layered windows pass alpha-zero pixels through; keep the full tiny target interactive. -->
  <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
  <Grid Width="40" Height="44">
   <views:CharacterAvatar x:Name="MiniAvatar" Width="28" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" CharacterId="{Binding CharacterId}" IsRecording="{Binding IsRecording}"/>
   <Ellipse x:Name="MiniBadge" Width="5" Height="5" Fill="{StaticResource Coral}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0" Visibility="Collapsed"/>
  </Grid>
 </Button>
 </Canvas></Window>
